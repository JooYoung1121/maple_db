# 프론트엔드 → API 연결 주소
# 로컬 개발 시 빈 값 (Next.js rewrite가 localhost:8000으로 프록시)
# 배포 시 API 서버 주소 설정 (예: https://api.example.com)
NEXT_PUBLIC_API_URL=

# API 서버 설정
API_HOST=0.0.0.0
API_PORT=8000
GAME_ADMIN_PASSWORD=

# AI API 키 (Claude + Gemini 분석 기능)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional legacy alias. GOOGLE_API_KEY also works for Gemini features.
GOOGLE_API_KEY=
# Optional model override for N-hit AI analysis. Defaults to Gemini free-tier friendly Flash-Lite.
GEMINI_NHIT_MODEL=gemini-2.5-flash-lite

# 메랜 공홈/테스피아 공지 자동 확인
MAPLE_LAND_CRAWLER_ENABLED=true
MAPLE_LAND_CRAWL_INTERVAL_MINUTES=30

# 주간 메랜 — 커뮤니티(디시 갤러리) 원자료 수집
COMMUNITY_CRAWLER_ENABLED=true
COMMUNITY_CRAWL_INTERVAL_MINUTES=360
# 주간 메랜 발행 리마인더 (매주 일요일, KST 기준 시각)
WEEKLY_REMINDER_ENABLED=true
WEEKLY_REMINDER_HOUR=8
# 주간 메랜 발행 스크립트용 라이브 API 주소 (로컬 전용이면 빈 값)
WEEKLY_API_BASE=
# 디스코드 발행 알림 임베드에 들어갈 사이트 주소 (예: https://example.com)
PUBLIC_SITE_URL=

# 디스코드 알림봇
DISCORD_BOT_TOKEN=
# 대화 기능 안전 기본값: 관리자 화면에서 켜거나 아래 값을 true로 설정
DISCORD_CHAT_ENABLED=false
# 지정 시 이 채널에서는 멘션 없이 자연어 대화, 다른 채널에서는 봇 멘션 필요
DISCORD_CHAT_CHANNEL_ID=
# 대화용 Gemini 모델 (미설정 시 gemini-2.5-flash)
GEMINI_CHAT_MODEL=
